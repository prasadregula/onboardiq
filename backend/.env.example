# --- OnboardIQ backend configuration (copy to .env). Everything is optional: with no values set the
# --- platform runs fully offline in scripted/mock mode.

ONBOARDIQ_ENV=dev
ONBOARDIQ_API_KEY=dev-key
ONBOARDIQ_CORS_ORIGINS=http://localhost:5180
# ONBOARDIQ_DATABASE_URL=mssql+pyodbc://...   (Azure SQL; default is SQLite under ./data)

# Orchestration: scripted (no model) | llm (tool-calling model)
ONBOARDIQ_ORCHESTRATOR_MODE=scripted

# LLM provider: auto | azure | ollama | mock.  auto = Azure if an endpoint is set, else local Ollama if it is
# running on localhost:11434, else mock. Set explicitly to avoid surprises.
ONBOARDIQ_LLM_PROVIDER=auto

# Local Ollama. Needs a tools-capable chat model; qwen2.5:14b is the best of the ones you have,
# llama3.1:8b also works. Embeddings: nomic-embed-text (ollama pull nomic-embed-text).
ONBOARDIQ_OLLAMA_BASE_URL=http://localhost:11434/v1
ONBOARDIQ_OLLAMA_CHAT_MODEL=qwen2.5:14b
ONBOARDIQ_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Azure OpenAI - Foundry resource in your tenant. Strip the /openai/v1 suffix the Foundry portal shows.
# Leave the key empty to use DefaultAzureCredential (az login locally, managed identity in Azure;
# needs 'Cognitive Services OpenAI User' on the resource).
# ONBOARDIQ_AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
# ONBOARDIQ_AZURE_OPENAI_API_KEY=
ONBOARDIQ_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
ONBOARDIQ_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Reasoning models (GPT-5 family, GPT-6, o-series) reject a custom temperature and need a newer API version.
# auto = detect from the deployment name; set yes/no when the name does not reveal the model.
# ONBOARDIQ_LLM_REASONING=auto
# ONBOARDIQ_LLM_REASONING_EFFORT=low
# ONBOARDIQ_AZURE_OPENAI_API_VERSION=<version shown on the deployment page in the Foundry portal>

# Cost estimate per run (USD per 1M tokens: [input, output, cached_input], matched by model/deployment name prefix).
# Defaults cover gpt-4.1 / gpt-4.1-mini / gpt-4.1-nano / gpt-4o family at 2026-09 list prices; override after checking
# the Azure OpenAI pricing page. Ollama models cost 0.
# ONBOARDIQ_LLM_PRICES={"gpt-4.1-mini": [0.40, 1.60, 0.10]}

# Azure Document Intelligence (extraction_provider=azure to enable)
ONBOARDIQ_EXTRACTION_PROVIDER=mock
# ONBOARDIQ_DOC_INTEL_ENDPOINT=https://di-onboardiq-dev.cognitiveservices.azure.com/
# ONBOARDIQ_DOC_INTEL_API_KEY=

# Screening: mock (bundled fictional demo list) | ofac_csv (download sdn.csv from sanctionslist.ofac.treas.gov)
ONBOARDIQ_SCREENING_PROVIDER=mock
# ONBOARDIQ_OFAC_SDN_CSV=./data/sdn.csv

# Azure AI Search for the policy index (optional; local JSON index is used when unset)
# ONBOARDIQ_SEARCH_ENDPOINT=https://srch-onboardiq-dev.search.windows.net
# ONBOARDIQ_SEARCH_API_KEY=
