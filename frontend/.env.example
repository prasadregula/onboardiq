# Base URL of the OnboardIQ API. In dev the Vite proxy forwards /api -> http://localhost:8080
# Ports: UI 5180, API 8080 
VITE_API_BASE=/api

# --- auth: apikey (dev) | entra (Microsoft Entra ID, standard Entra SPA + API recipe)
VITE_AUTH_MODE=apikey
VITE_API_KEY=dev-key
VITE_ANALYST=analyst1
VITE_ROLE=KycAnalyst            # apikey mode only: KycAnalyst | BsaOfficer | Auditor | Admin (comma-separated ok)

# entra mode: SPA app registration (OnboardIQ-Review) + API app registration (OnboardIQ-API) in your tenant
# VITE_TENANT_ID=<tenant guid>
# VITE_CLIENT_ID=<OnboardIQ-Review client id>
# VITE_API_CLIENT_ID=<OnboardIQ-API client id>        -> scope api://<id>/access_as_user
